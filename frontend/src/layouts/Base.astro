---
import type { Sito } from '../lib/api';
import Icona from '../components/Icona.astro';

/**
 * Cio' che il layout deve sapere di quello che sta rendendo.
 *
 * Prima prendeva una `Pagina` intera, e un articolo o un archivio non lo
 * sono: gli si sarebbe passato un oggetto finto con un `is_home` inventato,
 * e il canonico e il JSON-LD sarebbero usciti sbagliati senza che niente lo
 * segnalasse. Qui c'e' solo cio' che serve, e chi rende costruisce il proprio
 * grafo con la funzione giusta.
 */
export interface Documento {
  /** Il percorso canonico, con lo slash finale: '/', '/chi-siamo/', '/blog/x/'. */
  percorso: string;
  titolo: string;
  descrizione?: string | null;
  ogTitolo?: string | null;
  ogDescrizione?: string | null;
  noindex?: boolean;
  canonico?: string | null;
  /** Il file OG del sito, senza dominio: /og/<slug>.png. */
  og: string;
  jsonld: Record<string, unknown>[];
}

interface Props {
  documento: Documento;
  dominio: string;
  sito?: Sito;
}

const { documento, dominio, sito } = Astro.props;

const grafo = documento.jsonld;
const canonico = documento.canonico ?? `https://${dominio}${documento.percorso}`;

// L'immagine Open Graph e' un file del sito, generato in build.
const immagineOg = `https://${dominio}${documento.og}`;
const larghezzaOg = Number((sito?.og_config as Record<string, unknown> | undefined)?.larghezza ?? 1200);
const altezzaOg = Number((sito?.og_config as Record<string, unknown> | undefined)?.altezza ?? 1600);

// ---------------------------------------------------------------------------
// Testata e pie' di pagina arrivano dal CMS, non sono cablati qui: cambiare
// una voce di menu non deve richiedere una modifica al codice.
// Un sito appena creato non ha ancora nessuna configurazione, quindi ogni
// lettura ha un fallback che regge da solo. Un footer vuoto sarebbe peggio
// di un footer minimo.
// ---------------------------------------------------------------------------
const nomeSito = sito?.name ?? 'SlimCMS';
const testata = sito?.layout_config ?? {};
const marchio = testata.nome_visibile || nomeSito;
const mostraLogo = testata.mostra_logo !== false;
const vociMenu = testata.voci ?? [];

// Un tipo scritto a mano nel database, o rimasto da una versione vecchia,
// non deve produrre una testata senza stile: si ricade sulla disposizione
// predefinita, che e' quella che tutti i siti avevano.
const tipiTestata = ['semplice', 'centrata', 'divisa', 'compatta'] as const;
const tipoTestata = tipiTestata.includes(testata.tipo as (typeof tipiTestata)[number])
  ? (testata.tipo as (typeof tipiTestata)[number])
  : 'semplice';

const testataFissa = testata.fissa === true;

const barra = testata.barra ?? {};
const barraPiena = Boolean(barra.testo || barra.telefono || barra.email);

/*
 * Disposizione "divisa": meta' voci per lato.
 *
 * La regola e' fissata qui e non lasciata a un arrotondamento: con un numero
 * dispari la voce in piu' va a destra, e la voce in evidenza ci va sempre,
 * perche' e' l'azione e sta dove l'occhio finisce. Senza questa regola due
 * siti con lo stesso numero di voci si disporrebbero diversamente a seconda
 * dell'ordine in cui sono state inserite.
 */
const ordinarie = vociMenu.filter((v) => !v.evidenza);
const inEvidenza = vociMenu.filter((v) => v.evidenza);
const vociSinistra = ordinarie.slice(0, Math.floor(ordinarie.length / 2));
const vociDestra = [...ordinarie.slice(Math.floor(ordinarie.length / 2)), ...inEvidenza];

/** Il telefono come lo vuole un href: senza spazi ne' punteggiatura. */
const telefonoUrl = (n: string): string => `tel:${n.replace(/[^+\d]/g, '')}`;

const pie = sito?.footer_config ?? {};
const tipoPie = pie.tipo === 'colonne' ? 'colonne' : 'semplice';
const colonnePie = Math.min(3, Math.max(1, Number(pie.colonne ?? 3)));
// Piu' blocchi che colonne sarebbe contenuto scritto e mai mostrato: il
// pannello lo impedisce, ma una configurazione vecchia puo' averne di piu'.
const blocchiPie = (pie.blocchi ?? []).slice(0, colonnePie);
const mostraFirma = pie.firma !== false;
const organizzazione = pie.organizzazione ?? 'Content is King Srl';

// La riga legale e' un campo di testo unico, e i separatori li scrive il
// redattore. Emessi come testo, uno screen reader annuncia "punto mediano"
// a ogni voce: qui tornano a essere separatori, non contenuto.
const parti = (pie.legale ?? '').split('·').map((t) => t.trim()).filter(Boolean);

// I colori del tema stanno nel CMS: qui diventano variabili CSS che
// sovrascrivono quelle di default, senza duplicare tutto il foglio di stile.
const tema = (sito?.theme ?? {}) as Record<string, string>;
const variabiliTema = ['carta', 'inchiostro', 'segnale']
  .filter((k) => typeof tema[k] === 'string' && /^#[0-9a-fA-F]{3,8}$/.test(tema[k]))
  .map((k) => `--${k}:${tema[k]}`)
  .join(';');

const verifiche = sito?.seo_defaults?.webmaster ?? {};
const ga4 = sito?.seo_defaults?.analytics?.ga4 ?? null;
const anonimizza = sito?.seo_defaults?.analytics?.anonimizza !== false;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Favicon del sito: generata dalle iniziali, oppure il file che il
        cliente ha caricato. Ogni sito ha la sua.

        L'ICO va dichiarato anche se il browser lo chiederebbe comunque da
        solo: senza il link, la richiesta arriva fuori dal contesto della
        pagina e ogni visita ne paga una in piu'. Prima qui c'era
        `favicon_path`, che e' un percorso su un disco privato del backend:
        come href dava un 404 sicuro. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    {sito?.favicon_svg && (
      <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    )}
    <title>{documento.titolo}</title>
    {documento.descrizione && <meta name="description" content={documento.descrizione} />}
    <link rel="canonical" href={canonico} />
    {documento.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={documento.ogTitolo ?? documento.titolo} />
    {documento.ogDescrizione && <meta property="og:description" content={documento.ogDescrizione} />}
    <meta property="og:url" content={canonico} />

    {/* Immagine generata dalla piattaforma e scritta come file del sito: i
        social la rileggono a ogni condivisione e devono trovarla qui, non
        dietro un token dell'API. URL assoluta perche' Facebook e LinkedIn
        non risolvono i percorsi relativi. */}
    <meta property="og:image" content={immagineOg} />
    <meta property="og:image:width" content={String(larghezzaOg)} />
    <meta property="og:image:height" content={String(altezzaOg)} />
    <meta property="og:image:alt" content={documento.titolo} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={immagineOg} />

    {/*
      Preload dei SOLI due font necessari al primo rendering: il titolo usa
      Space Grotesk, il corpo Source Serif. JetBrains Mono compare piu' in
      basso e non va precaricato, perche' precaricare tutto equivale a non
      precaricare niente: si tolgono banda e priorita' a cio' che serve subito.
      crossorigin e' obbligatorio anche per i font di prima parte: senza,
      il browser scarica il file due volte.
    */}
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/space-grotesk-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/source-serif-4-latin.woff2" />

    {/* Verifica della proprieta' del sito. Il meta tag e' il metodo che
        Google, Bing e Yandex accettano tutti e tre, ed e' l'unico che non si
        perde a un cambio di DNS o di hosting. */}
    {verifiche.google && <meta name="google-site-verification" content={verifiche.google} />}
    {verifiche.bing && <meta name="msvalidate.01" content={verifiche.bing} />}
    {verifiche.yandex && <meta name="yandex-verification" content={verifiche.yandex} />}

    {grafo.map((n) => <script type="application/ld+json" set:html={JSON.stringify(n)} />)}

    {/* Analytics: scritto solo se il sito ne ha uno configurato. Un sito
        senza statistiche non deve pagare nessuna richiesta in piu'. */}
    {ga4 && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
        <script
          is:inline
          set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','${ga4}'${anonimizza ? ",{anonymize_ip:true}" : ''});`}
        />
      </>
    )}
  </head>

  <body style={variabiliTema}>
    <a class="skip" href="#contenuto">Vai al contenuto</a>

    <header class:list={['testata', `t-${tipoTestata}`, { fissa: testataFissa }]} data-testata>
      {barraPiena && (
        <div class="barra-servizio">
          {barra.testo && <span>{barra.testo}</span>}
          {barra.telefono && <a href={telefonoUrl(barra.telefono)}>{barra.telefono}</a>}
          {barra.email && <a href={`mailto:${barra.email}`}>{barra.email}</a>}
        </div>
      )}

      <div class="testata-interno">
        {/* Le voci del menu stanno nel documento UNA volta sola. Su telefono
            non si duplica l'elenco dentro un pannello a parte: cambia solo
            come e' disposto lo stesso <nav>, cosi' uno screen reader non
            legge due volte la stessa navigazione. */}
        {tipoTestata === 'divisa' && vociSinistra.length > 0 && (
          <nav id="menu-sinistra" class="menu menu-lato" aria-label="Principale">
            {vociSinistra.map((v) => (
              <a href={v.url} class={v.evidenza ? 'nav-cta' : undefined}>{v.etichetta}</a>
            ))}
          </nav>
        )}

        <a class="marchio" href="/">
          {mostraLogo && <img src={sito?.logo_path ?? '/logo.svg'} alt="" width="32" height="32" />}
          <span>{marchio}</span>
        </a>

        {tipoTestata === 'divisa'
          ? vociDestra.length > 0 && (
              <nav id="menu-destra" class="menu menu-lato" aria-label={vociSinistra.length > 0 ? 'Secondaria' : 'Principale'}>
                {vociDestra.map((v) => (
                  <a href={v.url} class={v.evidenza ? 'nav-cta' : undefined}>{v.etichetta}</a>
                ))}
              </nav>
            )
          : vociMenu.length > 0 && (
              <nav id="menu-principale" class="menu" aria-label="Principale">
                {vociMenu.map((v) => (
                  <a href={v.url} class={v.evidenza ? 'nav-cta' : undefined}>{v.etichetta}</a>
                ))}
              </nav>
            )}

        {vociMenu.length > 0 && (
          <button
            type="button"
            class="pulsante-menu"
            aria-expanded="false"
            aria-controls={tipoTestata === 'divisa' ? 'menu-sinistra menu-destra' : 'menu-principale'}
            data-apri-menu
          >
            <span class="tratti" aria-hidden="true"></span>
            Menu
          </button>
        )}
      </div>
    </header>

    <main id="contenuto">
      <slot />
    </main>

    <footer>
      {tipoPie === 'colonne' && blocchiPie.length > 0 && (
        <nav class="pie-colonne" style={`--colonne-pie:${colonnePie}`} aria-label="Collegamenti del sito">
          {blocchiPie.map((c) => (
            <div class="pie-colonna">
              <h2>{c.titolo}</h2>
              <ul>
                {(c.voci ?? []).map((v) => (
                  <li><a href={v.url}>{v.etichetta}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      )}

      <div class="pie-alto">
        <div class="pie-marchio">
          {mostraLogo && <img src={sito?.logo_path ?? '/logo.svg'} alt="" width="26" height="26" />}
          <p>{marchio}{pie.descrizione ? ` — ${pie.descrizione}` : ''}</p>
        </div>
        {mostraFirma && (
          <p class="firma">
            Piattaforma realizzata con
            <Icona nome="cuore" etichetta="cuore" />
            <Icona nome="cervello" etichetta="cervello" />
            <Icona nome="braccio" etichetta="fatica" />
            e <Icona nome="robot" etichetta="robot" />
            in Italia da <strong>{organizzazione}</strong>
          </p>
        )}
      </div>

      {parti.length > 0 && (
        <p class="legale">
          {parti.map((t, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              {t}
            </>
          ))}
        </p>
      )}
    </footer>

    {/*
      Il pulsante del menu e' l'unico JavaScript del sito, ed e' inline: sono
      poche righe e caricarle da un file costerebbe una richiesta in piu' per
      qualcosa che serve al primo tocco. Senza JavaScript il menu resta
      visibile (la regola che lo nasconde vale solo da qui in poi), quindi la
      navigazione non si perde mai.
    */}
    <script is:inline>
      (() => {
        const testata = document.querySelector('[data-testata]');
        const pulsante = testata?.querySelector('[data-apri-menu]');

        if (!testata || !pulsante) return;

        // La regola CSS che nasconde il menu si attiva solo ora: se lo script
        // non gira, il menu resta aperto e leggibile invece che irraggiungibile.
        testata.dataset.jsAttivo = '';

        const chiudi = () => {
          delete testata.dataset.aperto;
          pulsante.setAttribute('aria-expanded', 'false');
        };

        pulsante.addEventListener('click', () => {
          const aperto = testata.dataset.aperto !== undefined;

          if (aperto) chiudi();
          else {
            testata.dataset.aperto = '';
            pulsante.setAttribute('aria-expanded', 'true');
          }
        });

        // Esc chiude e riporta il fuoco al pulsante: chi naviga da tastiera
        // non deve attraversare tutto il menu per uscirne.
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && testata.dataset.aperto !== undefined) {
            chiudi();
            pulsante.focus();
          }
        });

        // Un collegamento interno alla pagina non ricarica nulla: senza
        // questo il menu resterebbe aperto sopra il contenuto raggiunto.
        testata.querySelectorAll('.menu a').forEach((a) => a.addEventListener('click', chiudi));
      })();
    </script>

    <!--
      is:global e' necessario, non una scorciatoia: queste classi sono il
      sistema di design condiviso e vengono usate anche dal markup di
      Blocchi.astro. Con lo scoping di default Astro compila i selettori con
      [data-astro-cid-...] del SOLO componente che li dichiara, e tutto cio'
      che rende un altro componente resta senza stile.
      (Successo davvero: il 2026-09-04 il sito e' andato online mezzo nudo.)
      Gli stili specifici di un singolo blocco restano scoped in Blocchi.astro.
    -->
    <style is:global>
      /* --------------------------------------------------------------
         Font ospitati in proprio.
         Prima erano caricati da Google Fonts, il che imponeva una catena di
         tre richieste prima che il testo comparisse: HTML -> CSS di Google
         (che blocca il rendering) -> file dei font su un terzo dominio. Il
         browser non poteva nemmeno SCOPRIRE i font finche' il secondo passo
         non era finito, e su questa pagina l'elemento LCP e' testo.
         Ospitandoli qui restano due sole richieste, entrambe di prima parte,
         e i file diventano preloadabili con URL stabili.
         Sono font VARIABILI: un solo file copre tutti i pesi della famiglia.
         Il browser scarica latin-ext solo se la pagina contiene caratteri
         che lo richiedono (grazie a unicode-range).
         -------------------------------------------------------------- */

      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      @font-face {
        font-family: 'Source Serif 4';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/fonts/source-serif-4-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Source Serif 4';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/fonts/source-serif-4-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 100 800;
        font-display: swap;
        src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 100 800;
        font-display: swap;
        src: url('/fonts/jetbrains-mono-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      :root {
        --carta: #f4f4f1;
        --carta-alta: #fbfbf9;
        --inchiostro: #16181c;
        --inchiostro-tenue: #575d68;
        --riga: #dcdcd4;
        --segnale: #0f6b4a;
        --macchina-fondo: #191d26;
        --macchina-testo: #9aabc4;
        --macchina-chiave: #7fd1a8;
        --macchina-valore: #e0c169;

        --display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
        --corpo: "Source Serif 4", Georgia, "Times New Roman", serif;
        --mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Consolas, monospace;

        --misura: 1180px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--carta);
        color: var(--inchiostro);
        font-family: var(--corpo);
        font-size: 17px;
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--inchiostro);
        color: var(--carta);
        padding: 0.7rem 1.1rem;
        z-index: 10;
      }
      .skip:focus { left: 0; }

      :focus-visible {
        outline: 2px solid var(--segnale);
        outline-offset: 3px;
      }

      /* ---------- testata ---------- */

      /* La testata e' un contenitore a tutta larghezza: e' il suo INTERNO
         ad essere incolonnato. Senza questa separazione una testata fissa o
         con barra di servizio mostrerebbe lo sfondo della pagina ai lati. */
      .testata {
        background: var(--carta);
        border-bottom: 1px solid transparent;
      }

      .testata.fissa {
        position: sticky;
        top: 0;
        z-index: 30;
        border-bottom-color: var(--riga);
      }

      .barra-servizio {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 0.45rem 1.5rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.4rem;
        font-family: var(--display);
        font-size: 0.8rem;
        color: var(--inchiostro-tenue);
        border-bottom: 1px solid var(--riga);
      }
      .barra-servizio a { color: var(--segnale); text-decoration: none; }
      .barra-servizio a:hover { text-decoration: underline; }

      .testata-interno {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 1.6rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
      }

      /* --- disposizione: semplice --- */
      /* Non e' ridondante con la regola di base: e' cio' che DEFINISCE questa
         disposizione, e le altre tre la sovrascrivono. Scritta qui, cambiare
         il valore di base non cambia in silenzio anche questa. */
      .t-semplice .testata-interno { justify-content: space-between; }

      /* --- disposizione: centrata --- */
      .t-centrata .testata-interno {
        flex-direction: column;
        justify-content: center;
        gap: 1.1rem;
      }
      .t-centrata .marchio { font-size: 1.35rem; }

      /* --- disposizione: divisa --- */
      /* Le due meta' crescono in egual misura e il marchio resta al centro
         ottico anche se un lato ha etichette piu' lunghe dell'altro. */
      .t-divisa .menu-lato { flex: 1 1 0; }
      .t-divisa #menu-sinistra { justify-content: flex-end; }
      .t-divisa #menu-destra { justify-content: flex-start; }

      /* --- disposizione: compatta --- */
      /* Il menu sta dietro il pulsante a ogni larghezza, non solo su telefono.
         Nascosto SOLO se lo script che lo riapre sta girando: altrimenti il
         pulsante sarebbe inerte e la navigazione irraggiungibile. */
      .t-compatta[data-js-attivo] .menu { display: none; }
      .t-compatta .pulsante-menu { display: inline-flex; }
      .t-compatta[data-aperto] .menu { display: flex; }

      /* --- pulsante del menu --- */
      .pulsante-menu {
        display: none;
        align-items: center;
        gap: 0.55rem;
        background: none;
        border: 1px solid var(--riga);
        border-radius: 2px;
        padding: 0.5rem 0.85rem;
        font-family: var(--display);
        font-size: 0.9rem;
        color: var(--inchiostro);
        cursor: pointer;
      }
      .pulsante-menu:hover { border-color: var(--inchiostro); }

      /* I tre tratti sono decorativi: il pulsante ha gia' la parola "Menu",
         che e' cio' che viene annunciato. */
      .tratti,
      .tratti::before,
      .tratti::after {
        display: block;
        width: 16px;
        height: 1.5px;
        background: currentColor;
      }
      .tratti { position: relative; }
      .tratti::before,
      .tratti::after { content: ''; position: absolute; left: 0; }
      .tratti::before { top: -5px; }
      .tratti::after { top: 5px; }

      .marchio {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: var(--inchiostro);
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.12rem;
        letter-spacing: -0.02em;
      }

      .menu {
        display: flex;
        align-items: center;
        gap: 1.6rem;
        font-family: var(--display);
        font-size: 0.93rem;
      }

      .menu a {
        color: var(--inchiostro-tenue);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
        transition: color 0.15s, border-color 0.15s;
      }
      .menu a:hover { color: var(--inchiostro); border-bottom-color: var(--segnale); }

      .nav-cta { color: var(--segnale) !important; font-weight: 500; }

      /* ---------- apertura ---------- */

      .apertura {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 5.5rem 1.5rem 4.5rem;
      }

      .occhiello,
      .etichetta {
        font-family: var(--mono);
        font-size: 0.73rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--segnale);
        margin: 0;
      }

      .apertura h1 {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(2.6rem, 7.2vw, 5.1rem);
        line-height: 1.02;
        letter-spacing: -0.038em;
        margin: 1.4rem 0 0;
        max-width: 16ch;
      }

      .apertura h1 em {
        font-style: normal;
        color: var(--segnale);
        /* la sottolineatura si ferma sotto la parola: e' il "taglio" del nome */
        box-shadow: inset 0 -0.14em 0 rgba(15, 107, 74, 0.18);
      }

      .sommario {
        max-width: 56ch;
        margin: 1.9rem 0 0;
        font-size: 1.19rem;
        color: var(--inchiostro-tenue);
      }

      .azioni { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.4rem; }

      .bottone {
        display: inline-block;
        font-family: var(--display);
        font-size: 0.96rem;
        font-weight: 500;
        padding: 0.78rem 1.5rem;
        border: 1px solid var(--riga);
        border-radius: 2px;
        text-decoration: none;
        color: var(--inchiostro);
        background: var(--carta-alta);
        transition: border-color 0.15s, transform 0.15s;
      }
      .bottone:hover { border-color: var(--inchiostro); transform: translateY(-1px); }

      .bottone.primario {
        background: var(--segnale);
        border-color: var(--segnale);
        color: #fff;
      }
      .bottone.primario:hover { background: #0c5a3e; border-color: #0c5a3e; }

      /* ---------- doppio registro (firma) ---------- */

      .doppio {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 3rem 1.5rem 5rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.2rem;
        align-items: start;
      }

      .doppio-testa { grid-column: 1 / -1; max-width: 60ch; }
      .doppio-testa p { margin: 0.9rem 0 0; font-size: 1.08rem; color: var(--inchiostro-tenue); }

      .pannello-macchina {
        background: var(--macchina-fondo);
        border-radius: 3px;
        overflow: hidden;
        font-family: var(--mono);
      }

      .pannello-barra {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.7rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.09);
        font-size: 0.72rem;
        color: #6b7a94;
        letter-spacing: 0.02em;
      }

      .punto {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--macchina-chiave);
        flex: none;
      }

      .pannello-macchina pre {
        margin: 0;
        padding: 1.15rem 1.1rem 1.4rem;
        overflow-x: auto;
        font-size: 0.79rem;
        line-height: 1.72;
        color: var(--macchina-testo);
      }

      .fatti {
        border-left: 2px solid var(--segnale);
        padding-left: 1.4rem;
      }
      .fatti ul { list-style: none; margin: 1rem 0 0; padding: 0; }
      .fatti li {
        padding: 0.72rem 0;
        border-bottom: 1px solid var(--riga);
        font-size: 1rem;
      }
      .fatti li:last-child { border-bottom: 0; }

      /* ---------- capacita ---------- */

      .capacita {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
        border-top: 1px solid var(--riga);
      }

      .capacita-riga {
        display: grid;
        grid-template-columns: 12rem 1fr 16rem;
        gap: 2.2rem;
        align-items: start;
        padding: 2.9rem 0;
        border-bottom: 1px solid var(--riga);
      }
      .capacita-riga:last-child { border-bottom: 0; }

      .capacita-corpo h2 {
        font-family: var(--display);
        font-weight: 500;
        font-size: 1.62rem;
        letter-spacing: -0.02em;
        line-height: 1.2;
        margin: 0 0 0.7rem;
      }
      .capacita-corpo p { margin: 0; color: var(--inchiostro-tenue); max-width: 52ch; }

      .capacita-macchina {
        font-family: var(--mono);
        font-size: 0.74rem;
        line-height: 1.75;
        color: var(--macchina-testo);
        background: var(--macchina-fondo);
        padding: 0.8rem 0.9rem;
        border-radius: 3px;
        display: block;
        overflow-x: auto;
      }

      /* ---------- chiusura ---------- */

      .chiusura {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 4.5rem 1.5rem 5.5rem;
        border-top: 1px solid var(--riga);
      }
      .chiusura h2 {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(1.8rem, 4vw, 2.7rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        margin: 0;
        max-width: 20ch;
      }
      .chiusura p {
        max-width: 56ch;
        margin: 1.2rem 0 2rem;
        font-size: 1.1rem;
        color: var(--inchiostro-tenue);
      }

      /* ---------- pie' di pagina ---------- */

      footer {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 2rem 1.5rem 3.5rem;
        border-top: 1px solid var(--riga);
        font-family: var(--display);
        font-size: 0.88rem;
        color: var(--inchiostro-tenue);
      }
      footer p { margin: 0; }

      .pie-alto {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.2rem 2rem;
        flex-wrap: wrap;
      }

      /* Le colonne le decide il pannello, quindi il numero arriva come
         variabile. minmax(0,1fr) e non 1fr: senza, un collegamento lungo
         allarga la colonna oltre la griglia invece di andare a capo. */
      .pie-colonne {
        display: grid;
        grid-template-columns: repeat(var(--colonne-pie, 3), minmax(0, 1fr));
        gap: 1.6rem 2.4rem;
        margin-bottom: 2.2rem;
      }

      .pie-colonna h2 {
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        color: var(--inchiostro);
        margin: 0 0 0.7rem;
      }

      .pie-colonna ul { list-style: none; margin: 0; padding: 0; }
      .pie-colonna li + li { margin-top: 0.42rem; }

      .pie-colonna a {
        color: var(--inchiostro-tenue);
        text-decoration: none;
        border-bottom: 1px solid transparent;
      }
      .pie-colonna a:hover { color: var(--inchiostro); border-bottom-color: var(--segnale); }

      .pie-marchio { display: flex; align-items: center; gap: 0.7rem; }

      .firma {
        max-width: 46ch;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .28em;
      }
      .firma strong { color: var(--inchiostro); font-weight: 500; }
      /* Le icone ereditano il colore del testo: nel footer sono grigie
         come il resto, non quattro macchie colorate. */

      .legale {
        margin-top: 1.6rem !important;
        padding-top: 1.3rem;
        border-top: 1px solid var(--riga);
        font-size: 0.79rem;
        opacity: 0.75;
        line-height: 1.7;
      }

      /* ---------- adattivo ---------- */

      @media (max-width: 860px) {
        .doppio { grid-template-columns: 1fr; }
        /* Sotto i 640px affiancare due o tre elenchi li rende illeggibili:
           si impilano, e il footer resta l'ultima cosa che si legge. */
        .pie-colonne { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .capacita-riga { grid-template-columns: 1fr; gap: 1rem; }
        .apertura { padding-top: 3.5rem; }
        .menu { gap: 1.1rem; font-size: 0.87rem; }

        /* Su telefono il menu passa dietro il pulsante, in ogni
           disposizione. Prima, con piu' di quattro voci, andava a capo su
           due righe e si accavallava al marchio. */
        .testata-interno { flex-wrap: wrap; }
        .t-centrata .testata-interno { flex-direction: row; }

        .testata[data-js-attivo] .menu { display: none; }

        .menu {
          flex-basis: 100%;
          flex-direction: column;
          align-items: stretch;
          gap: 0;
          border-top: 1px solid var(--riga);
          margin-top: 0.4rem;
        }
        .menu a { padding: 0.85rem 0; border-bottom: 1px solid var(--riga); }
        .menu a:last-child { border-bottom: 0; }

        .testata[data-aperto] .menu { display: flex; }
        .t-divisa .menu-lato { flex: 1 1 100%; }
        .t-divisa #menu-sinistra,
        .t-divisa #menu-destra { justify-content: stretch; }
        /* La meta' di destra segue quella di sinistra senza stacco: aperte
           sono un elenco solo. */
        .t-divisa[data-aperto] #menu-destra { border-top: 0; margin-top: 0; }

        .pulsante-menu { display: inline-flex; }
      }

      @media (max-width: 640px) {
        .pie-colonne { grid-template-columns: minmax(0, 1fr); gap: 1.4rem; }
      }
    </style>

    {/*
      Il contatore delle visite.

      Un'immagine e non solo uno script: il sito e' statico, quindi una
      visita non lascia traccia da nessuna parte, e l'unico modo di vederla
      senza leggere i log del server e' che il client chieda qualcosa servito
      da nostro codice. Verificato sul traffico vero di slimcms.it: ClaudeBot
      scarica logo, font e favicon, quindi un pixel lo prende — con il solo
      JavaScript i bot AI sarebbero invisibili.

      Lo script manda un SECONDO evento, che non e' una visita: e' la
      conferma che quel client esegue JavaScript. Serve a distinguere una
      persona da uno scanner che si dichiara Chrome e non esegue mai niente —
      sul traffico reale di slimcms.it sono 58 richieste su 575.

      Niente cookie e nessun indirizzo IP conservato: l'importazione lo usa
      per un'impronta con un sale che cambia ogni giorno, e poi lo butta.
    */}
    <img
      src={`/slimcms-vista.php?p=${encodeURIComponent(documento.percorso)}`}
      alt=""
      width="1"
      height="1"
      loading="eager"
      decoding="async"
      style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none"
    />
    <script is:inline>
      (function () {
        try {
          var p = encodeURIComponent(window.location.pathname);
          new Image().src = '/slimcms-vista.php?e=j&p=' + p;
        } catch (e) {
          /* un contatore non deve mai rompere una pagina */
        }
      })();
    </script>
  </body>
</html>
