---
import type { Pagina, Sito } from '../lib/api';
import { grafoJsonLd } from '../lib/jsonld';

interface Props {
  pagina: Pagina;
  dominio: string;
  sito?: Sito;
}

const { pagina, dominio, sito } = Astro.props;

const editore = {
  '@type': 'Organization',
  name: 'Content is King Srl',
  vatID: 'IT11732600967',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'via Carducci 8',
    postalCode: '20814',
    addressLocality: 'Varedo',
    addressRegion: 'MB',
    addressCountry: 'IT',
  },
};

const grafo = grafoJsonLd(pagina, dominio, editore);
const canonico = pagina.seo.canonical_url ?? `https://${dominio}${pagina.slug === 'home' ? '/' : `/${pagina.slug}/`}`;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Favicon del sito: generata dalle iniziali, oppure il file che il
        cliente ha caricato. Ogni sito ha la sua. */}
    <link rel="icon" href={sito?.favicon_path ?? '/favicon.svg'} type="image/svg+xml" />
    <title>{pagina.seo.meta_title}</title>
    {pagina.seo.meta_description && <meta name="description" content={pagina.seo.meta_description} />}
    <link rel="canonical" href={canonico} />
    {pagina.seo.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pagina.seo.og_title ?? pagina.seo.meta_title} />
    {pagina.seo.og_description && <meta property="og:description" content={pagina.seo.og_description} />}
    <meta property="og:url" content={canonico} />

    {/*
      Preload dei SOLI due font necessari al primo rendering: il titolo usa
      Space Grotesk, il corpo Source Serif. JetBrains Mono compare piu' in
      basso e non va precaricato, perche' precaricare tutto equivale a non
      precaricare niente: si tolgono banda e priorita' a cio' che serve subito.
      crossorigin e' obbligatorio anche per i font di prima parte: senza,
      il browser scarica il file due volte.
    */}
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/space-grotesk-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/source-serif-4-latin.woff2" />

    {grafo.map((n) => <script type="application/ld+json" set:html={JSON.stringify(n)} />)}
  </head>

  <body>
    <a class="skip" href="#contenuto">Vai al contenuto</a>

    <header class="testata">
      <a class="marchio" href="/">
        <img src="/logo.svg" alt="" width="32" height="32" />
        <span>SlimCMS</span>
      </a>
      <nav aria-label="Principale">
        <a href="#capacita">Cosa fa</a>
        <a href="#macchina">Per le macchine</a>
        <a href="mailto:ciao@slimcms.it" class="nav-cta">Parlane con noi</a>
      </nav>
    </header>

    <main id="contenuto">
      <slot />
    </main>

    <footer>
      <div class="pie-alto">
        <div class="pie-marchio">
          <img src="/logo.svg" alt="" width="26" height="26" />
          <p>SlimCMS — piattaforma CMS multitenant</p>
        </div>
        <p class="firma">
          Piattaforma realizzata con
          <span class="emoji" role="img" aria-label="cuore">❤️</span>
          <span class="emoji" role="img" aria-label="cervello">🧠</span>
          <span class="emoji" role="img" aria-label="braccio">💪</span>
          e <span class="emoji" role="img" aria-label="robot">🤖</span>
          in Italia da <strong>Content is King Srl</strong>
        </p>
      </div>
      <p class="legale">
        © 2026 SlimCMS <span aria-hidden="true">·</span> Content is King Srl
        <span aria-hidden="true">·</span> via Carducci 8, 20814 Varedo (MB)
        <span aria-hidden="true">·</span> P.IVA IT11732600967
      </p>
    </footer>

    <!--
      is:global e' necessario, non una scorciatoia: queste classi sono il
      sistema di design condiviso e vengono usate anche dal markup di
      Blocchi.astro. Con lo scoping di default Astro compila i selettori con
      [data-astro-cid-...] del SOLO componente che li dichiara, e tutto cio'
      che rende un altro componente resta senza stile.
      (Successo davvero: il 2026-09-04 il sito e' andato online mezzo nudo.)
      Gli stili specifici di un singolo blocco restano scoped in Blocchi.astro.
    -->
    <style is:global>
      /* --------------------------------------------------------------
         Font ospitati in proprio.
         Prima erano caricati da Google Fonts, il che imponeva una catena di
         tre richieste prima che il testo comparisse: HTML -> CSS di Google
         (che blocca il rendering) -> file dei font su un terzo dominio. Il
         browser non poteva nemmeno SCOPRIRE i font finche' il secondo passo
         non era finito, e su questa pagina l'elemento LCP e' testo.
         Ospitandoli qui restano due sole richieste, entrambe di prima parte,
         e i file diventano preloadabili con URL stabili.
         Sono font VARIABILI: un solo file copre tutti i pesi della famiglia.
         Il browser scarica latin-ext solo se la pagina contiene caratteri
         che lo richiedono (grazie a unicode-range).
         -------------------------------------------------------------- */

      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Space Grotesk';
        font-style: normal;
        font-weight: 300 700;
        font-display: swap;
        src: url('/fonts/space-grotesk-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      @font-face {
        font-family: 'Source Serif 4';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/fonts/source-serif-4-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'Source Serif 4';
        font-style: normal;
        font-weight: 200 900;
        font-display: swap;
        src: url('/fonts/source-serif-4-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 100 800;
        font-display: swap;
        src: url('/fonts/jetbrains-mono-latin.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }

      @font-face {
        font-family: 'JetBrains Mono';
        font-style: normal;
        font-weight: 100 800;
        font-display: swap;
        src: url('/fonts/jetbrains-mono-latin-ext.woff2') format('woff2');
        unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
      }

      :root {
        --carta: #f4f4f1;
        --carta-alta: #fbfbf9;
        --inchiostro: #16181c;
        --inchiostro-tenue: #575d68;
        --riga: #dcdcd4;
        --segnale: #0f6b4a;
        --macchina-fondo: #191d26;
        --macchina-testo: #9aabc4;
        --macchina-chiave: #7fd1a8;
        --macchina-valore: #e0c169;

        --display: "Space Grotesk", ui-sans-serif, system-ui, sans-serif;
        --corpo: "Source Serif 4", Georgia, "Times New Roman", serif;
        --mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Consolas, monospace;

        --misura: 1180px;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--carta);
        color: var(--inchiostro);
        font-family: var(--corpo);
        font-size: 17px;
        line-height: 1.62;
        -webkit-font-smoothing: antialiased;
      }

      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--inchiostro);
        color: var(--carta);
        padding: 0.7rem 1.1rem;
        z-index: 10;
      }
      .skip:focus { left: 0; }

      :focus-visible {
        outline: 2px solid var(--segnale);
        outline-offset: 3px;
      }

      /* ---------- testata ---------- */

      .testata {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 1.6rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .marchio {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        text-decoration: none;
        color: var(--inchiostro);
        font-family: var(--display);
        font-weight: 700;
        font-size: 1.12rem;
        letter-spacing: -0.02em;
      }

      .testata nav {
        display: flex;
        align-items: center;
        gap: 1.6rem;
        font-family: var(--display);
        font-size: 0.93rem;
      }

      .testata nav a {
        color: var(--inchiostro-tenue);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        padding-bottom: 2px;
        transition: color 0.15s, border-color 0.15s;
      }
      .testata nav a:hover { color: var(--inchiostro); border-bottom-color: var(--segnale); }

      .nav-cta { color: var(--segnale) !important; font-weight: 500; }

      /* ---------- apertura ---------- */

      .apertura {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 5.5rem 1.5rem 4.5rem;
      }

      .occhiello,
      .etichetta {
        font-family: var(--mono);
        font-size: 0.73rem;
        letter-spacing: 0.13em;
        text-transform: uppercase;
        color: var(--segnale);
        margin: 0;
      }

      .apertura h1 {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(2.6rem, 7.2vw, 5.1rem);
        line-height: 1.02;
        letter-spacing: -0.038em;
        margin: 1.4rem 0 0;
        max-width: 16ch;
      }

      .apertura h1 em {
        font-style: normal;
        color: var(--segnale);
        /* la sottolineatura si ferma sotto la parola: e' il "taglio" del nome */
        box-shadow: inset 0 -0.14em 0 rgba(15, 107, 74, 0.18);
      }

      .sommario {
        max-width: 56ch;
        margin: 1.9rem 0 0;
        font-size: 1.19rem;
        color: var(--inchiostro-tenue);
      }

      .azioni { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2.4rem; }

      .bottone {
        display: inline-block;
        font-family: var(--display);
        font-size: 0.96rem;
        font-weight: 500;
        padding: 0.78rem 1.5rem;
        border: 1px solid var(--riga);
        border-radius: 2px;
        text-decoration: none;
        color: var(--inchiostro);
        background: var(--carta-alta);
        transition: border-color 0.15s, transform 0.15s;
      }
      .bottone:hover { border-color: var(--inchiostro); transform: translateY(-1px); }

      .bottone.primario {
        background: var(--segnale);
        border-color: var(--segnale);
        color: #fff;
      }
      .bottone.primario:hover { background: #0c5a3e; border-color: #0c5a3e; }

      /* ---------- doppio registro (firma) ---------- */

      .doppio {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 3rem 1.5rem 5rem;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.2rem;
        align-items: start;
      }

      .doppio-testa { grid-column: 1 / -1; max-width: 60ch; }
      .doppio-testa p { margin: 0.9rem 0 0; font-size: 1.08rem; color: var(--inchiostro-tenue); }

      .pannello-macchina {
        background: var(--macchina-fondo);
        border-radius: 3px;
        overflow: hidden;
        font-family: var(--mono);
      }

      .pannello-barra {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.7rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.09);
        font-size: 0.72rem;
        color: #6b7a94;
        letter-spacing: 0.02em;
      }

      .punto {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--macchina-chiave);
        flex: none;
      }

      .pannello-macchina pre {
        margin: 0;
        padding: 1.15rem 1.1rem 1.4rem;
        overflow-x: auto;
        font-size: 0.79rem;
        line-height: 1.72;
        color: var(--macchina-testo);
      }

      .fatti {
        border-left: 2px solid var(--segnale);
        padding-left: 1.4rem;
      }
      .fatti ul { list-style: none; margin: 1rem 0 0; padding: 0; }
      .fatti li {
        padding: 0.72rem 0;
        border-bottom: 1px solid var(--riga);
        font-size: 1rem;
      }
      .fatti li:last-child { border-bottom: 0; }

      /* ---------- capacita ---------- */

      .capacita {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 0 1.5rem 4rem;
        border-top: 1px solid var(--riga);
      }

      .capacita-riga {
        display: grid;
        grid-template-columns: 12rem 1fr 16rem;
        gap: 2.2rem;
        align-items: start;
        padding: 2.9rem 0;
        border-bottom: 1px solid var(--riga);
      }
      .capacita-riga:last-child { border-bottom: 0; }

      .capacita-corpo h2 {
        font-family: var(--display);
        font-weight: 500;
        font-size: 1.62rem;
        letter-spacing: -0.02em;
        line-height: 1.2;
        margin: 0 0 0.7rem;
      }
      .capacita-corpo p { margin: 0; color: var(--inchiostro-tenue); max-width: 52ch; }

      .capacita-macchina {
        font-family: var(--mono);
        font-size: 0.74rem;
        line-height: 1.75;
        color: var(--macchina-testo);
        background: var(--macchina-fondo);
        padding: 0.8rem 0.9rem;
        border-radius: 3px;
        display: block;
        overflow-x: auto;
      }

      /* ---------- chiusura ---------- */

      .chiusura {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 4.5rem 1.5rem 5.5rem;
        border-top: 1px solid var(--riga);
      }
      .chiusura h2 {
        font-family: var(--display);
        font-weight: 700;
        font-size: clamp(1.8rem, 4vw, 2.7rem);
        letter-spacing: -0.03em;
        line-height: 1.12;
        margin: 0;
        max-width: 20ch;
      }
      .chiusura p {
        max-width: 56ch;
        margin: 1.2rem 0 2rem;
        font-size: 1.1rem;
        color: var(--inchiostro-tenue);
      }

      /* ---------- pie' di pagina ---------- */

      footer {
        max-width: var(--misura);
        margin: 0 auto;
        padding: 2rem 1.5rem 3.5rem;
        border-top: 1px solid var(--riga);
        font-family: var(--display);
        font-size: 0.88rem;
        color: var(--inchiostro-tenue);
      }
      footer p { margin: 0; }

      .pie-alto {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.2rem 2rem;
        flex-wrap: wrap;
      }

      .pie-marchio { display: flex; align-items: center; gap: 0.7rem; }

      .firma { max-width: 44ch; }
      .firma strong { color: var(--inchiostro); font-weight: 500; }
      /* le emoji restano alla loro dimensione naturale, allineate al testo */
      .firma .emoji { font-size: 1.02em; line-height: 1; }

      .legale {
        margin-top: 1.6rem !important;
        padding-top: 1.3rem;
        border-top: 1px solid var(--riga);
        font-size: 0.79rem;
        opacity: 0.75;
        line-height: 1.7;
      }

      /* ---------- adattivo ---------- */

      @media (max-width: 860px) {
        .doppio { grid-template-columns: 1fr; }
        .capacita-riga { grid-template-columns: 1fr; gap: 1rem; }
        .apertura { padding-top: 3.5rem; }
        .testata nav { gap: 1.1rem; font-size: 0.87rem; }
      }
    </style>
  </body>
</html>
