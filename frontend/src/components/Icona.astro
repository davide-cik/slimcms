---
/**
 * Icone della firma nel footer.
 *
 * Sostituiscono le emoji: quelle le disegna il sistema operativo, quindi
 * cambiano forma, colore e peso su ogni dispositivo e stonano con una
 * tipografia scelta. Queste ereditano currentColor e si allineano al testo.
 *
 * Monolinea, viewBox 24 e tratto 1.8: a 16px restano leggibili senza
 * impastarsi, che e' la dimensione a cui verranno viste davvero.
 */
interface Props {
  nome: 'cuore' | 'cervello' | 'braccio' | 'robot';
  etichetta: string;
}

const { nome, etichetta } = Astro.props;
---

<svg
  class="icona"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-label={etichetta}
>
  <title>{etichetta}</title>

  {nome === 'cuore' && (
    <path d="M12 20.4C10.4 19 3.5 14.6 3.5 9.6A4.6 4.6 0 0 1 12 7a4.6 4.6 0 0 1 8.5 2.6c0 5-6.9 9.4-8.5 10.8Z" />
  )}

  {nome === 'cervello' && (
    <>
      <path d="M12 5.2v14" />
      <path d="M12 6.4A3 3 0 0 0 6.6 5a2.7 2.7 0 0 0-3 3.6 2.9 2.9 0 0 0-.4 4.2 2.8 2.8 0 0 0 1.5 4.3A2.9 2.9 0 0 0 12 18.6" />
      <path d="M12 6.4A3 3 0 0 1 17.4 5a2.7 2.7 0 0 1 3 3.6 2.9 2.9 0 0 1 .4 4.2 2.8 2.8 0 0 1-1.5 4.3A2.9 2.9 0 0 1 12 18.6" />
    </>
  )}

  {nome === 'braccio' && (
    <>
      <path d="M3.6 15.4V11a2.4 2.4 0 0 1 2.4-2.4h4.6a3.6 3.6 0 0 0 3.6-3.6 2 2 0 0 1 2-2 3.8 3.8 0 0 1 3.8 3.8v3.4a9 9 0 0 1-9 9H6a2.4 2.4 0 0 1-2.4-2.4Z" />
      <path d="M9 12.6a3.4 3.4 0 0 1 3.4 3.4" />
    </>
  )}

  {nome === 'robot' && (
    <>
      <rect x="3.6" y="8" width="16.8" height="12" rx="3" />
      <path d="M12 4.2V8" />
      <circle cx="12" cy="3" r="1.2" />
      <path d="M9 13v1.6M15 13v1.6" />
      <path d="M1.8 12.6v2.8M22.2 12.6v2.8" />
    </>
  )}
</svg>

<style>
  .icona {
    width: 1.15em;
    height: 1.15em;
    /* Allineata alla linea del testo, non alla base: senza, le icone
       "galleggiano" sopra le parole che le circondano. */
    vertical-align: -0.22em;
    flex: none;
  }
</style>
