---
import { sito } from '../../lib/api';

/**
 * Il modulo di contatto: l'unica parte del sito pubblico che scrive.
 *
 * Il resto del sito e' statico e non tocca il backend (sezione 7 delle
 * specifiche). Qui si': il messaggio deve arrivare da qualche parte. La
 * chiamata parte dal browser del visitatore verso l'API, che sta su un altro
 * dominio — da cui il CORS lato Laravel e il dominio del sito dentro la URL,
 * perche' l'Host che arriva all'API e' sempre quello dell'API.
 *
 * L'indirizzo dell'endpoint si calcola **qui nel frontmatter**, cioe' in fase
 * di build, e viaggia come attributo. `src/lib/api.ts` non va importato da
 * codice che gira nel browser: porta il token di build.
 */
export interface CampoModulo {
  nome: string;
  etichetta: string;
  tipo: 'testo' | 'testo_lungo' | 'email' | 'telefono' | 'numero' | 'scelta' | 'consenso';
  obbligatorio: boolean;
  opzioni: string[];
}

interface Props {
  titolo?: string;
  testo?: string;
  etichetta?: string;
  conferma?: string;
  /** Il modulo scelto nel pannello, risolto dall'API con i suoi campi. */
  modulo?: { slug: string; nome: string; conferma?: string | null; campi: CampoModulo[] } | null;
}

const { titolo, testo, etichetta, conferma, modulo } = Astro.props;

const campi: CampoModulo[] = modulo?.campi ?? [];

// Il captcha lo sceglie il sito. La configurazione si legge in fase di build:
// `api.ts` non va importato da codice che gira nel browser, porta il token.
const infoSito = await sito();
const captcha = infoSito.captcha ?? { tipo: 'semplice' as const };

const base = (import.meta.env.SLIMCMS_API_URL ?? '').replace(/\/$/, '');
const dominio = import.meta.env.SLIMCMS_SITE ?? '';

if (!base || !dominio) {
  throw new Error(
    'Modulo di contatto: SLIMCMS_API_URL o SLIMCMS_SITE non impostati. ' +
      'Senza, il modulo verrebbe pubblicato con un indirizzo vuoto e ogni ' +
      'messaggio andrebbe perso in silenzio.'
  );
}

const endpoint = `${base}/public/${dominio}/contact`;
const endpointCaptcha = `${base}/public/${dominio}/captcha`;

// Gli id devono essere unici: una pagina puo' avere due moduli, e due
// `for="mc-nome"` fanno puntare la seconda etichetta al primo campo.
const uid = `mc-${Math.random().toString(36).slice(2, 8)}`;
---

{/*
  La sezione e' `chiusura`, la stessa che usano gli altri blocchi del sito:
  cosi' il modulo eredita misura, margini, spaziatura verticale e stile dei
  titoli dal tema, e li segue anche quando il tema cambia. Inventando una
  sezione propria — com'era — restava incollato a sinistra mentre tutto il
  resto della pagina era centrato.
*/}
<section class="chiusura modulo-contatto">
  {titolo && <h2>{titolo}</h2>}
  {testo && <p>{testo}</p>}

  <form
    class="modulo"
    data-endpoint={endpoint}
    data-conferma={conferma || modulo?.conferma || 'Grazie, ti rispondiamo al più presto.'}
    data-modulo={modulo?.slug ?? ''}
    data-captcha={captcha.tipo}
    data-captcha-url={endpointCaptcha}
    data-captcha-chiave={captcha.chiave ?? ''}
    novalidate
  >
    <div class="campo">
      <label for={`${uid}-nome`}>Nome</label>
      <input id={`${uid}-nome`} name="name" type="text" required maxlength="120" autocomplete="name" />
    </div>

    <div class="campo">
      <label for={`${uid}-email`}>Email</label>
      <input id={`${uid}-email`} name="email" type="email" required maxlength="180" autocomplete="email" />
    </div>

    <div class="campo">
      <label for={`${uid}-messaggio`}>Messaggio</label>
      <textarea id={`${uid}-messaggio`} name="message" required maxlength="5000" rows="6"></textarea>
    </div>

    {campi.map((c) => (
      <div class={c.tipo === 'consenso' ? 'campo campo-consenso' : 'campo'}>
        {c.tipo === 'consenso' ? (
          <label>
            <input type="checkbox" name={`dati[${c.nome}]`} value="1" required={c.obbligatorio} />
            <span>{c.etichetta}</span>
          </label>
        ) : (
          <>
            <label for={`${uid}-${c.nome}`}>{c.etichetta}</label>
            {c.tipo === 'testo_lungo' ? (
              <textarea id={`${uid}-${c.nome}`} name={`dati[${c.nome}]`} rows="4" required={c.obbligatorio} maxlength="5000" />
            ) : c.tipo === 'scelta' ? (
              <select id={`${uid}-${c.nome}`} name={`dati[${c.nome}]`} required={c.obbligatorio}>
                <option value="">Scegli…</option>
                {c.opzioni.map((o) => <option value={o}>{o}</option>)}
              </select>
            ) : (
              <input
                id={`${uid}-${c.nome}`}
                name={`dati[${c.nome}]`}
                type={c.tipo === 'email' ? 'email' : c.tipo === 'telefono' ? 'tel' : c.tipo === 'numero' ? 'number' : 'text'}
                required={c.obbligatorio}
                maxlength="200"
              />
            )}
          </>
        )}
      </div>
    ))}

    {/*
      Trappola per i bot: un campo che un umano non vede e non compila mai.
      Nascosto con CSS e non con `type=hidden`, che i bot riconoscono; fuori
      dall'ordine di tabulazione e ignorato dai lettori di schermo, cosi' non
      da' fastidio a chi naviga da tastiera.
    */}
    <div class="esca" aria-hidden="true">
      <label for={`${uid}-website`}>Non compilare</label>
      <input id={`${uid}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    {/*
      La verifica anti-spam. Quella semplice arriva dall'API a pagina
      caricata e non in fase di build: una domanda cucita nell'HTML sarebbe
      identica per tutti i visitatori e resterebbe valida finche' dura la
      cache del sito, cioe' non sarebbe una verifica.
    */}
    {captcha.tipo === 'semplice' && (
      <div class="campo campo-captcha" hidden>
        <label for={`${uid}-captcha`}><span class="captcha-domanda"></span></label>
        <input id={`${uid}-captcha`} name="captcha" type="text" inputmode="numeric" autocomplete="off" />
        <input type="hidden" name="captcha_token" value="" />
      </div>
    )}

    {captcha.tipo === 'turnstile' && captcha.chiave && (
      <div class="cf-turnstile" data-sitekey={captcha.chiave} data-theme="auto"></div>
    )}

    <button type="submit">{etichetta || 'Invia il messaggio'}</button>

    <p class="modulo-esito" role="status" aria-live="polite"></p>
  </form>
</section>

{captcha.tipo === 'turnstile' && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

{captcha.tipo === 'recaptcha' && captcha.chiave && (
  <script is:inline async defer src={`https://www.google.com/recaptcha/api.js?render=${captcha.chiave}`}></script>
)}

<script is:inline>
  (function () {
    // Tutti i moduli della pagina, non uno solo: il blocco si puo' mettere
    // due volte, e con un id fisso il secondo non funzionerebbe.
    var moduli = document.querySelectorAll('form.modulo[data-endpoint]');

    Array.prototype.forEach.call(moduli, function (modulo) {
      if (modulo.dataset.legato === '1') return;
      modulo.dataset.legato = '1';

      var esito = modulo.querySelector('.modulo-esito');
      var pulsante = modulo.querySelector('button[type=submit]');
      var etichettaOriginale = pulsante ? pulsante.textContent : '';
      var tipoCaptcha = modulo.dataset.captcha || 'nessuno';

      function messaggio(testo, tipo) {
        if (!esito) return;
        esito.textContent = testo;
        esito.className = 'modulo-esito ' + tipo;
      }

      // ---- captcha semplice: la domanda arriva dall'API, non dall'HTML.
      // Cucita nella pagina sarebbe identica per tutti i visitatori e
      // valida finche' dura la cache del sito: non sarebbe una verifica.
      function caricaSfida() {
        if (tipoCaptcha !== 'semplice') return Promise.resolve();

        var riquadro = modulo.querySelector('.campo-captcha');
        if (!riquadro) return Promise.resolve();

        return fetch(modulo.dataset.captchaUrl)
          .then(function (r) { return r.json(); })
          .then(function (d) {
            if (!d || !d.sfida) return;
            riquadro.querySelector('.captcha-domanda').textContent = d.sfida.domanda;
            riquadro.querySelector('input[name=captcha_token]').value = d.sfida.token;
            riquadro.querySelector('input[name=captcha]').value = '';
            riquadro.querySelector('input[name=captcha]').required = true;
            riquadro.hidden = false;
          })
          .catch(function () {
            // Senza domanda il campo resta nascosto e non obbligatorio: il
            // server rifiutera' l'invio, ma non si chiede a chi scrive di
            // rispondere a una domanda che non e' comparsa.
          });
      }

      caricaSfida();

      // ---- reCAPTCHA v3: il gettone si prende al momento dell'invio.
      function gettoneRecaptcha() {
        if (tipoCaptcha !== 'recaptcha' || typeof grecaptcha === 'undefined') {
          return Promise.resolve(null);
        }

        return new Promise(function (risolvi) {
          grecaptcha.ready(function () {
            grecaptcha
              .execute(modulo.dataset.captchaChiave || '', { action: 'contatto' })
              .then(risolvi)
              .catch(function () { risolvi(null); });
          });
        });
      }

      modulo.addEventListener('submit', function (evento) {
        evento.preventDefault();

        // La validazione del browser resta la prima linea: `novalidate`
        // toglie solo i messaggi automatici, non i vincoli.
        if (!modulo.checkValidity()) {
          messaggio('Controlla i campi obbligatori.', 'errore');
          modulo.reportValidity();
          return;
        }

        if (pulsante) {
          pulsante.disabled = true;
          pulsante.textContent = 'Invio…';
        }
        messaggio('', '');

        gettoneRecaptcha()
          .then(function (gettone) {
            var dati = new FormData(modulo);
            dati.append('page', window.location.pathname);

            if (modulo.dataset.modulo) dati.append('modulo', modulo.dataset.modulo);
            if (gettone) dati.append('g-recaptcha-response', gettone);

            return fetch(modulo.dataset.endpoint, {
              method: 'POST',
              headers: { Accept: 'application/json' },
              body: dati,
            });
          })
          .then(function (r) {
            return r.json().then(function (corpo) {
              return { ok: r.ok, stato: r.status, corpo: corpo };
            });
          })
          .then(function (r) {
            if (r.ok) {
              modulo.reset();
              messaggio(r.corpo && r.corpo.message ? r.corpo.message : modulo.dataset.conferma, 'ok');
              // Il gettone appena speso non vale piu': ne serve uno nuovo
              // per un secondo invio.
              caricaSfida();
              if (typeof turnstile !== 'undefined') turnstile.reset();
              return;
            }

            // 429: troppi invii ravvicinati. Dirlo evita che chi ha scritto
            // davvero riprovi a vuoto.
            if (r.stato === 429) {
              messaggio('Hai già inviato un messaggio poco fa. Riprova fra un minuto.', 'errore');
              return;
            }

            var errori = r.corpo && r.corpo.errors ? Object.values(r.corpo.errors)[0] : null;
            messaggio(
              errori && errori[0] ? errori[0] : 'Non è stato possibile inviare il messaggio.',
              'errore'
            );

            // Una verifica fallita consuma comunque la domanda.
            caricaSfida();
            if (typeof turnstile !== 'undefined') turnstile.reset();
          })
          .catch(function () {
            messaggio(
              'Non è stato possibile inviare il messaggio. Controlla la connessione e riprova.',
              'errore'
            );
          })
          .finally(function () {
            if (pulsante) {
              pulsante.disabled = false;
              pulsante.textContent = etichettaOriginale;
            }
          });
      });
    });
  })();
</script>

<style>
  /* Solo l'interno del modulo. Misura, margini e spaziatura della sezione
     vengono da `.chiusura` in Base.astro, che e' il contenitore di tutti i
     blocchi: qui non si ricopiano, altrimenti divergono al primo tema nuovo. */

  /* `.chiusura` porta una riga sopra, che separa il modulo dal contenuto
     precedente. Subito sotto l'apertura di una pagina non separa niente: e'
     solo una riga appiccicata al titolo. */
  :global(.apertura + .modulo-contatto) {
    border-top: 0;
    padding-top: 0;
  }

  .modulo {
    /* I campi non devono essere larghi quanto un paragrafo: una riga di
       input lunga mezzo schermo si legge peggio, non meglio. */
    max-width: 34rem;
    margin-top: 2rem;
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.1rem;
  }

  .campo label {
    font-family: var(--mono, inherit);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--inchiostro-tenue, inherit);
  }

  .campo input,
  .campo select,
  .campo textarea {
    font: inherit;
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--riga, rgba(0, 0, 0, 0.25));
    border-radius: 4px;
    background: transparent;
    color: inherit;
  }

  .campo textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .campo input:focus-visible,
  .campo select:focus-visible,
  .campo textarea:focus-visible {
    outline: 2px solid var(--segnale, currentColor);
    outline-offset: 1px;
    border-color: transparent;
  }

  /* Il consenso e' una casella con l'etichetta accanto, non sopra. */
  .campo-consenso label {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-family: inherit;
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.45;
  }

  .campo-consenso input {
    width: auto;
    margin-top: 0.15rem;
    flex: 0 0 auto;
  }

  /* Nascosto finche' la domanda non arriva dall'API: un campo obbligatorio
     senza domanda sarebbe un modulo che non si puo' inviare. */
  .campo-captcha[hidden] {
    display: none;
  }

  .campo-captcha input {
    max-width: 8rem;
  }

  .captcha-domanda {
    font-family: inherit;
    font-size: 0.95rem;
    letter-spacing: 0;
    text-transform: none;
  }

  /* L'esca non deve essere raggiungibile ne' visibile, ma deve restare nel
     DOM: `display:none` la fa saltare a qualche bot. */
  .esca {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* Lo stesso pulsante degli altri blocchi: `bottone primario` e' definito
     nel tema, e usarlo qui vuol dire che il modulo non ha un pulsante suo
     che invecchia per conto proprio. */
  .modulo button {
    font: inherit;
    font-family: var(--display, inherit);
    font-weight: 600;
    padding: 0.8rem 1.6rem;
    border: 0;
    border-radius: 4px;
    background: var(--segnale, #0f6b4a);
    color: var(--fondo, #fff);
    cursor: pointer;
  }

  .modulo button:hover:not([disabled]) {
    filter: brightness(1.1);
  }

  .modulo button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .modulo-esito:empty {
    display: none;
  }

  .modulo-esito {
    margin-top: 1.2rem;
    padding: 0.8rem 1rem;
    border-radius: 4px;
    font-size: 0.98rem;
    border: 1px solid var(--riga, rgba(0, 0, 0, 0.15));
  }

  .modulo-esito.ok {
    border-color: var(--segnale, #0f6b4a);
  }

  .modulo-esito.errore {
    border-color: #a01e1e;
  }
</style>
