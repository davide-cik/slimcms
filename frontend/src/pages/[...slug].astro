---
import Base from '../layouts/Base.astro';
import Blocchi from '../components/blocchi/Blocchi.astro';
import { elencoPagine, sito, type Pagina, type Sito } from '../lib/api';

/**
 * Genera staticamente TUTTE le pagine pubblicate del sito, leggendole
 * dall'API Laravel in fase di build. Il visitatore riceve HTML gia' pronto
 * e non tocca mai il backend (specifiche, sezione 7).
 */
export async function getStaticPaths() {
  // Il sito si legge UNA volta e si passa a tutte le pagine: e' lo stesso per
  // ognuna, e rileggerlo per pagina sarebbe una chiamata sprecata per nulla.
  const [pagine, s] = await Promise.all([elencoPagine(), sito()]);

  return pagine.map((pagina: Pagina) => ({
    // La pagina iniziale vive alla radice, le altre al proprio slug.
    // Lo decide il flag is_home, non uno slug convenuto: cosi' rinominare
    // lo slug non sposta per sbaglio la home.
    params: { slug: pagina.is_home ? undefined : pagina.slug },
    props: { pagina, sito: s },
  }));
}

const { pagina, sito: infoSito } = Astro.props as { pagina: Pagina; sito: Sito };
const dominio = import.meta.env.SLIMCMS_SITE ?? 'slimcms.it';

// Il doppio registro e' una scelta del sito, non del layout: c'e' solo se il
// pannello l'ha attivato, e il testo introduttivo e' quello scritto li'.
const doppio = infoSito?.layout_config?.doppio ?? {};
const mostraDoppio =
  doppio.attivo === true &&
  (Boolean(pagina.geo.structured_summary) || pagina.geo.key_facts.length > 0);
---

<Base pagina={pagina} dominio={dominio} sito={infoSito}>
  <Blocchi blocchi={pagina.blocks} colonne={pagina.colonne} />

  {/* Il doppio registro: la firma della pagina. Quello che legge una
      persona sopra, quello che legge un crawler qui sotto — generato dagli
      stessi campi, non scritto a mano. */}
  {
    mostraDoppio && (
      <section class="doppio" id="macchina">
        <div class="doppio-testa">
          {doppio.etichetta && <span class="etichetta">{doppio.etichetta}</span>}
          {doppio.testo && <p>{doppio.testo}</p>}
        </div>

        {pagina.geo.structured_summary && (
          <div class="pannello-macchina">
            <div class="pannello-barra">
              <span class="punto" />
              <span>structured_summary — {dominio}/{pagina.is_home ? '' : pagina.slug}</span>
            </div>
            <pre><code>{pagina.geo.structured_summary}</code></pre>
          </div>
        )}

        {pagina.geo.key_facts.length > 0 && (
          <div class="fatti">
            <span class="etichetta">key_facts[]</span>
            <ul>
              {pagina.geo.key_facts.map((f: string) => <li>{f}</li>)}
            </ul>
          </div>
        )}
      </section>
    )
  }
</Base>
