# URL base dell'API Laravel (senza slash finale)
SLIMCMS_API_URL=http://127.0.0.1:8000/api

# Dominio del sito da generare
SLIMCMS_SITE=slimcms.it

# Token di build, emesso con:
#   php artisan slimcms:build-token <email> --site=<dominio>
# Vale solo per il sito indicato: un token di un cliente non legge gli altri.
SLIMCMS_API_TOKEN=
